# Test appending values to a sub-element of some variable.
let var = {
	'a' => (1,2,3),
	'b' => (4,5,6),
	'c' => (7,8,9),
}

function print_var
	print "{@1}:"
	for key value in {var.pairs().sort()} do
		print "{key} => {value.json_encode()}"
	end
	print
end

call print_var Original

# Append another element to var.c
let var{'c'}{} = 10

call print_var Modified
