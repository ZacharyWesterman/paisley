#[[
@file This module adds functions for making HTTP requests.

# Functions:
```
function http.get ... end
function http.post ... end
```
#]]

#[[
@brief Sends an HTTP GET request to the specified URL.
@param url string The URL to send the GET request to.
@return string The response body from the server if successful.
@error http_error If the CURL request failed.
@export
#]]
function http.get
	# This is just a wrapper around curl for simplicity.
	?! curl -s {@1}
	if ${=} else
		error ${!} as http_error
	end
	return ${?}
end

#[[
@brief Sends an HTTP POST request to the specified URL with the given data.
@param url string The URL to send the POST request to.
@param data string The data to include in the POST request body.
@return string The response body from the server if successful.
@error http_error If the CURL request failed.
@export
#]]
function http.post
	# This is just a wrapper around curl for simplicity.
	?! curl -s -X POST -d {@2} {@1}
	if ${=} else
		error ${!} as http_error
	end
	return ${?}
end
