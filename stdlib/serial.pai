#[[
@file Serialization functions for various data formats.

### Functions:
```
function serialize ... end # Serialize arbitrary data into a byte string which can be easily deserialized.
function deserialize ... end # Deserialize a byte string into arbitrary data.

function serialize.int ... end # Serialize a 32-bit integer to a 4-byte string.
function serialize.long ... end # Serialize a 64-bit integer to an 8-byte string.
function serialize.bool ... end # Serialize a boolean.
function serialize.float ... end # Serialize a float to a byte string.
function serialize.string ... end # Serialize a variable-length string.
function serialize.varint ... end # Serialize a variable-length integer.

function deserialize.int ... end # Deserialize a 32-bit integer from a 4-byte string.
function deserialize.long ... end # Deserialize a 64-bit integer from an 8-byte string.
function deserialize.bool ... end # Deserialize a boolean.
function deserialize.float ... end # Deserialize a float from a byte string.
function deserialize.string ... end # Deserialize a variable-length string.
function deserialize.varint ... end # Deserialize a variable-length integer.
```
#]]

#[[
@export
@brief Serialize arbitrary data into a byte string.

This byte string differs from the `serialize.*` methods in that each chunk of serialized data
contains a 1-byte prefix indicating what type it is. In this way, the data is easy to deserialize
without knowing the data structure beforehand.

@param value any The data to serialize.
@return string The serialized data.
#]]
function serialize
	let _data = {@1}
	match {type(_data)} do
		# Strings
		return "s{_data.\serialize.string()}" if string
		# Booleans
		return "b{_data.\serialize.bool()}" if boolean
		# Numbers
		if number then
			if {floor(_data) = _data} then
				return "i{\serialize.varint(_data)}"
			else
				return "f{\serialize.float(_data)}"
			end
		end
		# Arrays
		if array then
			return "a{len(_data).\serialize.varint()}{(
				\serialize(i) for i in _data
			).join('')}"
		end
		# Objects
		if object then
			return "o{\serialize.varint(_data.keys().len() * 2)}{(
				\serialize(i) for i in _data.array()
			).join('')}"
		end
	else
		# Null
		return n
	end
end

function deserialize
	#@type string string
	let _type _text = {@1[1], @1[2::]}
	match {_type} do
		return {null} if n
		return {\deserialize.bool(_text)} if b
		return {\deserialize.varint(_text)} if i
		return {\deserialize.float(_text)} if f
		return {\deserialize.string(_text)} if s
	end

	# Both arrays and objects are serialized as arrays under the hood
	# TODO: implement array/object deserialization.
end

#[[
@export
@brief Serialize a 32-bit integer to a 4-byte string.
@param value number The integer to serialize.
@return string A string of 4 bytes.
#]]
function serialize.int
	return {
		(
			char(i) for i in @1.bytes(4).reverse()
		).join("")
	}
end

#[[
@export
@brief Deserialize a 32-bit integer from a 4-byte string.
If the string is longer than 4-bytes, any remaining bytes are ignored.
@param text string The string to deserialize from.
@return array[number|string] A 32-bit integer, and any remaining text.
#]]
function deserialize.int
	return {
		(ascii(i) for i in @1[1:4].split('')).reverse().frombytes(),
		@1[5::],
	}
end

#[[
@export
@brief Serialize a variable-length integer to a string of minimal size.
@param value number The integer to serialize.
@return string The serialized string.
#]]
function serialize.varint
	let _num = {@1}
	let _byte_ct = {_num.log(2).floor()}
	return "{char(_byte_ct)}{(
		char(i) for i in _num.bytes(_byte_ct)
	).join('')}"
end

#[[
@export
@brief Deserialize a variable-length integer from a byte string.
@param text string The string to deserialize from.
@return array[number|string] An integer and any remaining text.
#]]
function deserialize.varint
	#@type string
	let _text = {@1}
	let _len = {_text[1].ascii()}
	let _num = {(ascii(i) for i in (_text[2:(_len + 1)]).split('')).reverse().frombytes()}

	let _result = {
		_num,
		_text[(_len+2)::],
	}
	delete _text _len _num

	return {_result}
end

#[[
@export
@brief Serialize a 64-bit integer to an 8-byte string.
@param value number The integer to serialize.
@return string A string of 8 bytes.
#]]
function serialize.long
	return {
		(
			char(i) for i in @1.bytes(8).reverse()
		).join("")
	}
end

#[[
@export
@brief Deserialize a 64-bit integer from an 8-byte string.
If the string is longer than 8-bytes, any remaining bytes are ignored.
@param text string The string to deserialize from.
@return array[number|string] A 64-bit integer, and any remaining text.
#]]
function deserialize.long
	return {
		(ascii(i) for i in @1[1:8].split('')).reverse().frombytes(),
		@1[9::],
	}
end

#[[
@export
@brief Serialize a variable-length string.
@param value string The string to serialize.
@return string The serialized string.
#]]
function serialize.string
	return "{\serialize.varint(len(@1))}{@1}"
end

#[[
@export
@brief Deserialize a variable-length string.
@param text string The string to deserialize from.
@return array[string] The deserialized string, and any remaining text.
#]]
function deserialize.string
	#@type number string
	let _len _remd = {\deserialize.int(@1)}
	return {
		_remd[1:_len],
		_remd[(_len+1)::],
	}
end

#[[
@export
@brief Serialize a boolean.
@param value boolean The boolean to serialize.
@return string The serialized string.
#]]
function serialize.bool
	return {'\x01' if @1 else '\x00'}
end

#[[
@export
@brief Deserialize a boolean.
@param text string The string to deserialize from.
@return array[boolean|string] The deserialized boolean, and any remaining text.
#]]
function deserialize.bool
	return {
		@1[1] != '\x00',
		@1[2::],
	}
end

#[[
@export
@brief Serialize a float to a byte string.
@param value number The float to serialize.
@return string A string of bytes.
#]]
function serialize.float
	let _int _frac = {@1.modf()}
	return "{
		\serialize.varint(_int)
	}{
		\serialize.varint(floor(1 / _frac))
	}"
end

#[[
@export
@brief Deserialize a float from a byte string.
@param text string The string to deserialize from.
@return array[number|string] A float and any remaining text.
#]]
function deserialize.float
	#@type number string
	let _int _text = {\deserialize.varint(@1)}
	#@type number string
	let _frac _text = {\deserialize.varint(@1)}

	return {
		_int + 1 / _frac,
		_text
	}
end
